#!/bin/bash

# omarchy:summary=Show the current battery status notification

status_output=$(omarchy-battery-status)
[[ -z $status_output ]] && exit 0

if [[ $(omarchy-i18n "ui.battery.locale" "en") == "zh" ]]; then
  declare -A fields=()
  while IFS=$'\t' read -r k v; do
    [[ -n $k ]] && fields["$k"]="$v"
  done < <(omarchy-battery-status --shell)

  pct="${fields[percentage]:-}"
  state="${fields[state]:-}"
  rate="${fields[rate]:-}"
  size="${fields[size]:-}"
  time="${fields[time]:-}"
  threshold="${fields[threshold]:-}"

  if [[ $state == "holding" ]]; then
    msg="电池 ${pct}  ·  保持在 ${threshold}  ·  ${rate} / ${size}"
  elif [[ $state == "charging" ]]; then
    if [[ -n $time ]]; then
      time_part="${time} 后充满"
    else
      time_part="正在充电"
    fi
    msg="电池 ${pct}  ·  ${time_part}  ·   ${rate} / ${size}"
  else
    if [[ -n $time ]]; then
      time_part="剩余 ${time}"
    else
      time_part="正在放电"
    fi
    msg="电池 ${pct}  ·  ${time_part}  ·   ${rate} / ${size}"
  fi
else
  msg="$status_output"
fi

omarchy-notification-send -g 󰁹 -u low "$msg"
